.env
.env.local
.env.*.local
config.local.js
secrets.js
api_key.txt
*.key
*.pem

# ── macOS system files ─────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Windows system files ───────────────────────
desktop.ini
$RECYCLE.BIN/

# ── Editor & IDE files ─────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath

# ── Temporary & build files ────────────────────
*.tmp
*.temp
*.bak
*.orig
dist/
build/
.cache/

# ── Node (if you ever add a build step) ────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ── Local test output ──────────────────────────
test-results/
*.test.html
*_local.html

